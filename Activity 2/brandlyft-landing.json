{
  "page": {
    "title": "BrandLyft - Engage Audiences with Stunning Videos",
    "background": {
      "type": "linear-gradient",
      "direction": "160deg",
      "stops": [
        { "color": "#312E81", "position": "0%" },
        { "color": "#7C3AED", "position": "45%" },
        { "color": "#F472B6", "position": "100%" }
      ]
    },
    "container": {
      "background": "#FBF8FF",
      "borderRadius": 24,
      "border": "6px solid rgba(255,255,255,0.35)",
      "boxShadow": "0 30px 80px rgba(30,27,75,0.35)",
      "padding": "24px 28px 56px"
    },
    "fonts": {
      "heading": "Bricolage Grotesque, sans-serif",
      "body": "Inter, sans-serif",
      "handwritten": "Caveat, cursive"
    },
    "colors": {
      "text": "#1E1B4B",
      "muted": "#4C4A7A",
      "badgeBackground": "#EDE0FF",
      "badgeText": "#5B21B6",
      "noteColor": "#7C3AED",
      "ctaGradient": ["#7C3AED", "#EC4899"],
      "ctaText": "#FFFFFF",
      "signupBackground": "#1E1B4B",
      "loginBackground": "#FFFFFF"
    }
  },
  "navbar": {
    "logo": {
      "text": "BrandLyft",
      "iconColor": "#7C3AED"
    },
    "links": [
      { "label": "Brands", "href": "#brands" },
      { "label": "Creators", "href": "#creators" },
      { "label": "Pricing", "href": "#pricing" },
      { "label": "Use Cases", "href": "#use-cases" },
      { "label": "Contact", "href": "#contact" }
    ],
    "actions": [
      { "label": "Log in", "href": "/login", "variant": "light" },
      { "label": "Sign up", "href": "/signup", "variant": "dark" }
    ]
  },
  "hero": {
    "badge": {
      "text": "Join over 100,000 happy creators",
      "variant": "pill-lavender"
    },
    "headline": {
      "lines": ["Engage Audiences", "with Stunning Videos"],
      "gradientLine": 1,
      "gradient": ["#7C3AED", "#EC4899"],
      "fontSize": 64,
      "fontWeight": 600,
      "align": "center"
    },
    "subheadline": {
      "text": "Boost Your Brand with High-Impact Short Videos from our expert content creators. Our team is ready to propel your business forward",
      "fontSize": 15,
      "maxWidth": 400,
      "align": "center"
    },
    "annotations": [
      {
        "type": "handwritten-note",
        "text": "Elevate your brand",
        "position": "right-of-headline",
        "rotation": 25,
        "color": "#7C3AED"
      },
      {
        "type": "handwritten-note",
        "text": "It's free",
        "position": "left-of-cta",
        "rotation": 20,
        "color": "#7C3AED"
      }
    ]
  },
  "videoCarousel": {
    "layout": "horizontal-3d-curve",
    "cardBorderRadius": 24,
    "cardSize": { "width": 140, "height": 190 },
    "gap": 16,
    "items": [
      { "id": 1, "alt": "Hands mixing a bowl with oranges", "image": "video-1.jpg", "tilt": "left", "fallback": "#C4B5FD" },
      { "id": 2, "alt": "People dancing in a patterned room", "image": "video-2.jpg", "tilt": "left", "fallback": "#A78BFA" },
      { "id": 3, "alt": "Person sitting on a rocky coast", "image": "video-3.jpg", "tilt": "none", "fallback": "#818CF8" },
      { "id": 4, "alt": "Facial mask skincare treatment", "image": "video-4.jpg", "tilt": "none", "fallback": "#F9A8D4" },
      { "id": 5, "alt": "Sliced grapefruit and lemons", "image": "video-5.jpg", "tilt": "none", "fallback": "#F472B6" },
      { "id": 6, "alt": "Woman cooking with fresh herbs", "image": "video-6.jpg", "tilt": "right", "fallback": "#8B5CF6" },
      { "id": 7, "alt": "Motorcyclist on a bridge", "image": "video-7.jpg", "tilt": "right", "fallback": "#6366F1" }
    ]
  },
  "cta": {
    "label": "Get Started",
    "href": "/signup",
    "style": {
      "background": "linear-gradient(135deg, #7C3AED, #EC4899)",
      "color": "#FFFFFF",
      "borderRadius": 999,
      "padding": "14px 36px",
      "boxShadow": "0 8px 20px rgba(124,58,237,0.35)",
      "outline": "2px dashed rgba(124,58,237,0.45)",
      "outlineOffset": 4
    }
  }
}